# Copy to .env on your own machine. Never commit real keys.
# Local default: Gemini Developer API.
GENAI_BACKEND=developer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Explicit public-reading release switch: false blocks every /api/generate request.
# Unset preserves historical generation behavior; true does not add auth or quotas.
# Set false in the deployed service until paid-generation authorization is ready.
# GENERATION_ENABLED=false
PORT=8787
# Optional allowed browser origin. Local Vite 5173/5174 is allowed by default.
# APP_ORIGIN=http://127.0.0.1:8787

# Cloud Run production: use Vertex AI workload identity, not GEMINI_API_KEY.
# GENAI_BACKEND=vertex
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Optional identity only. Leaving this disabled keeps all local reading available.
# Firebase's public Web API key is NOT a Gemini key. Never reuse GEMINI_API_KEY here.
AUTH_ENABLED=false
AUTH_GOOGLE_ENABLED=true
AUTH_EMAIL_ENABLED=true
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Server-only service-account JSON path, outside this repository; never expose it to Vite.
# If omitted, firebase-admin uses Application Default Credentials (for example Cloud Run identity).
# FIREBASE_ADMIN_CREDENTIALS_FILE=C:/secure/firebase-admin.json
# See docs/AUTH_SETUP.md before enabling. No cloud library, subscriptions or paid generation gates are enabled.
