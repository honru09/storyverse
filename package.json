{
  "name": "storyweave",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node e2e/journey.cjs && node e2e/recovery.cjs && node e2e/gemini.cjs",
    "test:onboarding": "node e2e/onboarding.cjs",
    "test:reader": "node e2e/reader.cjs",
    "build": "vite build",
    "gcp-build": "npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@firebase/app": "0.16.4",
    "@firebase/auth": "1.13.6",
    "@google/genai": "^2.30.0",
    "@gsap/react": "2.1.2",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.134.0",
    "vanta": "0.5.24"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "playwright": "1.62.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
